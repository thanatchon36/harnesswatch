{
  "mcpServers": {
    "sentry": {
      "command": "npx",
      "args": [
        "-y",
        "@sentry/mcp-server@^0.17.0"
      ],
      "env": {
        "SENTRY_AUTH_TOKEN": "{{SYNTH:high-entropy}}"
      }
    },
    "fetch": {
      "command": "uvx",
      "args": [
        "mcp-server-fetch==2025.4.7"
      ]
    },
    "gh-docker": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-e",
        "GITHUB_PERSONAL_ACCESS_TOKEN",
        "ghcr.io/github/github-mcp-server"
      ],
      "env": {
        "GITHUB_TOKEN": "${GITHUB_TOKEN}"
      }
    }
  }
}
