{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "*",
      "Bash(uv run pytest:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(sudo:*)"
    ]
  },
  "env": {
    "ANTHROPIC_API_KEY": "{{SYNTH:anthropic-api-key}}"
  },
  "sandbox": {
    "enabled": true,
    "network": {
      "allowedDomains": [
        "*"
      ]
    }
  }
}
