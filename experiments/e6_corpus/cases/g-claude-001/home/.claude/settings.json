{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(git log:*)",
      "WebFetch(domain:developer.mozilla.org)",
      "Bash(cargo test:*)",
      "WebFetch",
      "Bash(npm run test:*)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(sudo:*)"
    ]
  },
  "apiKeyHelper": "~/.claude/bin/get-api-key.sh",
  "enabledMcpjsonServers": [
    "github",
    "internal-docs"
  ]
}
