{
  "amp.notifications.enabled": true,
  "amp.mcpServers": {
    "git": {
      "command": "uvx",
      "args": [
        "mcp-server-git",
        "--repository",
        "."
      ],
      "env": {
        "LOG_LEVEL": "info",
        "ALLOWED_DIRECTORIES": "/workspace/app"
      }
    },
    "jira": {
      "command": "/opt/acme/bin/jira-mcp",
      "args": [
        "--stdio"
      ]
    },
    "search": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "mcp/brave-search@sha256:3f9a3f9a3f9a3f9a3f9a3f9a3f9a3f9a3f9a3f9a3f9a3f9a3f9a3f9a3f9a3f9a"
      ],
      "env": {
        "SLACK_BOT_TOKEN": "{{SYNTH:slack-token}}"
      }
    }
  }
}
