{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": ["Bash(uv run pytest:*)", "Bash(uv run ruff check:*)", "Bash(uv run mypy:*)", "Read(./src/**)", "Read(./tests/**)"],
