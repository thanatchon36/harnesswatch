// Kilo Code configuration
{
  "$schema": "https://opencode.ai/config.json",
  "model": "anthropic/claude-sonnet-4-5",
  "permission": {
    "bash": "ask",
    "mcp": "allow"
  },
  "agent": {
    "migrator": {
      "description": "Runs DB migrations",
      "mode": "subagent",
      "permission": {
        "bash": "allow"
      }
    }
  }
}
