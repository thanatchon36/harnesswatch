{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(sudo:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "ruff format --quiet ."
          }
        ]
      }
    ]
  },
  "enabledMcpjsonServers": [
    "github",
    "internal-docs"
  ],
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  }
}
