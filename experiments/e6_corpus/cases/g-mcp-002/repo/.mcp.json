{
  "mcpServers": {
    "linear": {
      "type": "http",
      "url": "https://mcp.linear.example.com/mcp",
      "headers": {
        "Authorization": "Bearer ${MCP_TOKEN}"
      }
    },
    "context": {
      "type": "http",
      "url": "https://mcp.context.example.com/mcp"
    },
    "fetch": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "mcp-server-fetch==2025.4.7"
      ],
      "env": {
        "OPENAI_API_KEY": "{{SYNTH:openai-api-key}}"
      }
    }
  }
}
