{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "Read(./.env)",
      "Read(~/.ssh/**)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "prettier --write --log-level warn ."
          }
        ]
      }
    ]
  },
  "apiKeyHelper": "~/.claude/bin/get-api-key.sh",
  "autoMemoryEnabled": false,
  "sandbox": {
    "enabled": true,
    "network": {
      "allowedDomains": [
        "*"
      ]
    }
  }
}
