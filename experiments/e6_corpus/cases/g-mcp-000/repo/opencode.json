{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "time": {
      "type": "local",
      "command": [
        "uvx",
        "--from",
        "mcp-server-time==0.6.2",
        "mcp-server-time"
      ],
      "environment": {
        "LOG_LEVEL": "info",
        "ALLOWED_DIRECTORIES": "/workspace/app"
      }
    },
    "postgres": {
      "type": "local",
      "command": [
        "docker",
        "run",
        "-i",
        "--rm",
        "mcp/postgres:latest",
        "postgresql://db:5432/app"
      ]
    }
  }
}
